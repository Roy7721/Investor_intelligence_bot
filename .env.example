# Copy to .env and fill in. .env is gitignored and excluded from the Docker
# build context — keys reach the image through --secret, never through COPY.

# Gemini. Used for chat answers and KPI extraction.
GOOGLE_API_KEY=

# OpenRouter. Used for embeddings only (nvidia/nemotron-3-embed-1b:free).
OPENROUTER_API_KEY=

# Datalab (Marker). PDF -> markdown conversion.
# Only needed to ingest a new filing. The three bundled filings are already
# converted, so the app runs without this key.
DATALAB_API_KEY=
